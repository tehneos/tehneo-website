{
  "buildCommand": "node site/build.mjs",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "ai.tehneo.hr"
        }
      ],
      "destination": "https://www.tehneo.hr/",
      "permanent": false
    },
    {
      "source": "/solar",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/solar/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/solar/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/ai-data",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/ai-data/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/ai-data/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/tehneo-energy",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/tehneo-energy/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/tehneo-energy/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/automatika.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/automatika",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/robotika.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/robotika",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/dron.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/dron",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/energija.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/energija",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/potpis.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/potpis",
      "destination": "/",
      "permanent": false
    }
  ]
}
